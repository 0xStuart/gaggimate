// Copy to wifi_secrets.h (gitignored) for optional STA / BLE connect tests.
// Never commit wifi_secrets.h — it may contain credentials.

#pragma once

// 2.4 GHz only (ESP32-C6). Leave empty to scan without associating.
#define SPIKE_WIFI_SSID ""
#define SPIKE_WIFI_PASS ""

// Exact advertised name to GATT-connect after the BLE scan (optional).
// Example scale names vary by brand; leave empty to skip connect.
#define SPIKE_BLE_CONNECT_NAME ""
